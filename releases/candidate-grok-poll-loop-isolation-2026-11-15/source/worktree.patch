diff --git a/src/server/runtime-pollers.ts b/src/server/runtime-pollers.ts
new file mode 100644
index 0000000..35bd372
--- /dev/null
+++ b/src/server/runtime-pollers.ts
@@ -0,0 +1,92 @@
+export type RuntimePollComponent = 'run_scheduler' | 'routine_dispatch' | 'handoff_delivery' | 'expired_run_recovery';
+
+export type RuntimePollEvent = {
+  event: 'grok_runtime_poll_failed' | 'grok_runtime_poll_still_running';
+  component: RuntimePollComponent;
+  elapsedMs: number;
+  at: string;
+};
+
+export type RuntimePollerServices = {
+  scheduler: { tick(): Promise<void> };
+  routines: { dispatchDue(): Promise<unknown> };
+  handoffs: { deliverReplies(): Promise<unknown> };
+  runs: { markExpiredUnknown(): Promise<unknown> };
+};
+
+export type RuntimePollerOptions = {
+  intervalMs?: number;
+  slowAfterMs?: number;
+  onEvent?: (event: RuntimePollEvent) => void;
+};
+
+export type RuntimePollers = { stop(): void };
+
+const defaultLog = (event: RuntimePollEvent) => process.stderr.write(`${JSON.stringify(event)}\n`);
+
+/**
+ * Keep independent background work from blocking user run dispatch. A single
+ * poller never overlaps itself; slow and failed polls are observable, and a
+ * failed poll is retried on a later interval after its Promise has settled.
+ * A still-pending operation is not duplicated because its transaction may have
+ * an unknown outcome. Logs never include prompts, IDs, or raw error messages.
+ */
+export function startRuntimePollers(services: RuntimePollerServices, options: RuntimePollerOptions = {}): RuntimePollers {
+  const intervalMs = options.intervalMs ?? 2_000;
+  const slowAfterMs = options.slowAfterMs ?? Math.max(10_000, intervalMs * 3);
+  if (!Number.isSafeInteger(intervalMs) || intervalMs < 1 || !Number.isSafeInteger(slowAfterMs) || slowAfterMs < 1) {
+    throw new Error('Invalid runtime poll interval');
+  }
+  const log = options.onEvent ?? defaultLog;
+  const loops = [
+    startPoller('run_scheduler', () => services.scheduler.tick(), intervalMs, slowAfterMs, log),
+    startPoller('routine_dispatch', () => services.routines.dispatchDue(), intervalMs, slowAfterMs, log),
+    startPoller('handoff_delivery', () => services.handoffs.deliverReplies(), intervalMs, slowAfterMs, log),
+    startPoller('expired_run_recovery', () => services.runs.markExpiredUnknown(), intervalMs, slowAfterMs, log),
+  ];
+  return { stop: () => loops.forEach(loop => loop.stop()) };
+}
+
+function startPoller(
+  component: RuntimePollComponent,
+  operation: () => Promise<unknown>,
+  intervalMs: number,
+  slowAfterMs: number,
+  log: (event: RuntimePollEvent) => void,
+): { stop(): void } {
+  let stopped = false;
+  let inFlight = false;
+  let startedAt = 0;
+  let slowReported = false;
+
+  const execute = async () => {
+    if (stopped || inFlight) return;
+    inFlight = true;
+    startedAt = Date.now();
+    slowReported = false;
+    try {
+      await operation();
+    } catch {
+      log({ event: 'grok_runtime_poll_failed', component, elapsedMs: Date.now() - startedAt, at: new Date().toISOString() });
+    } finally {
+      inFlight = false;
+      startedAt = 0;
+    }
+  };
+
+  const timer = setInterval(() => {
+    if (inFlight) {
+      const elapsedMs = Date.now() - startedAt;
+      if (!slowReported && elapsedMs >= slowAfterMs) {
+        slowReported = true;
+        log({ event: 'grok_runtime_poll_still_running', component, elapsedMs, at: new Date().toISOString() });
+      }
+      return;
+    }
+    void execute();
+  }, intervalMs);
+  timer.unref();
+  void execute();
+
+  return { stop() { stopped = true; clearInterval(timer); } };
+}
diff --git a/tests/runtime-pollers.test.mjs b/tests/runtime-pollers.test.mjs
new file mode 100644
index 0000000..04f589a
--- /dev/null
+++ b/tests/runtime-pollers.test.mjs
@@ -0,0 +1,55 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { startRuntimePollers } from '../src/server/runtime-pollers.ts';
+
+async function waitFor(check, timeoutMs = 1_000) {
+  const started = Date.now();
+  while (Date.now() - started < timeoutMs) {
+    if (check()) return;
+    await new Promise(resolve => setTimeout(resolve, 5));
+  }
+  throw new Error('Timed out waiting for independent runtime pollers');
+}
+
+test('a slow routine dispatch does not block queued work, handoffs, or expired lease recovery', async () => {
+  let routineCalls = 0, schedulerCalls = 0, handoffCalls = 0, recoveryCalls = 0;
+  let releaseRoutine;
+  const events = [];
+  const pollers = startRuntimePollers({
+    scheduler: { async tick() { schedulerCalls++; } },
+    routines: { dispatchDue() { routineCalls++; return new Promise(resolve => { releaseRoutine = resolve; }); } },
+    handoffs: { async deliverReplies() { handoffCalls++; } },
+    runs: { async markExpiredUnknown() { recoveryCalls++; } },
+  }, { intervalMs: 10, slowAfterMs: 25, onEvent: event => events.push(event) });
+  try {
+    await waitFor(() => schedulerCalls >= 3 && handoffCalls >= 3 && recoveryCalls >= 3 && events.some(event => event.component === 'routine_dispatch'));
+    assert.equal(routineCalls, 1, 'a single poller must never overlap itself');
+    assert.ok(schedulerCalls >= 3, 'the run queue continues to advance while routine dispatch is slow');
+    assert.ok(handoffCalls >= 3, 'Bot handoff delivery has its own progress loop');
+    assert.ok(recoveryCalls >= 3, 'expired lease recovery has its own progress loop');
+    assert.deepEqual(events.filter(event => event.component === 'routine_dispatch').map(event => event.event), ['grok_runtime_poll_still_running']);
+  } finally {
+    pollers.stop();
+    releaseRoutine?.();
+  }
+});
+
+test('a failed poll is logged without raw error text and retried on the next interval', async () => {
+  let schedulerCalls = 0;
+  const events = [];
+  const pollers = startRuntimePollers({
+    scheduler: { async tick() { schedulerCalls++; if (schedulerCalls === 1) throw new Error('sensitive prompt text'); } },
+    routines: { async dispatchDue() {} },
+    handoffs: { async deliverReplies() {} },
+    runs: { async markExpiredUnknown() {} },
+  }, { intervalMs: 10, slowAfterMs: 100, onEvent: event => events.push(event) });
+  try {
+    await waitFor(() => schedulerCalls >= 2 && events.some(event => event.event === 'grok_runtime_poll_failed'));
+    const failure = events.find(event => event.event === 'grok_runtime_poll_failed');
+    assert.equal(failure.component, 'run_scheduler');
+    assert.equal('error' in failure, false);
+    assert.equal(JSON.stringify(failure).includes('sensitive prompt text'), false);
+  } finally {
+    pollers.stop();
+  }
+});
