FROM node:24-bookworm-slim@sha256:2af38505da611a8d2729ed2b6235f04613a4d5cf8b9340d3ca7b0ac54d1462a5
ENV NODE_ENV=production COKE_GROK_STATIC_DIR=/app/web
WORKDIR /app
COPY --chown=node:node artifacts/auth.cjs /app/auth.cjs
COPY --chown=node:node artifacts/web/index.html artifacts/web/web-build.json /app/web/
COPY --chown=node:node artifacts/web/assets/ /app/web/assets/
USER node
EXPOSE 3001
CMD ["node", "/app/auth.cjs"]
