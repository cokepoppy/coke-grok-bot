{
  "name": "coke-grok-bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/reference-frames.test.mjs",
    "test:mysql": "node --import tsx --test tests/mysql-tenant-store.test.ts",
    "test:ui": "node tests/ui.e2e.mjs",
    "compare:reference": "node --import tsx scripts/compare-reference.ts",
    "test:auth": "node --import tsx --test tests/google-auth.test.ts",
    "start:auth": "node --import tsx src/server/start-auth.ts",
    "test:auth-browser": "node --import tsx tests/auth-browser.e2e.ts",
    "test:google-proxy": "node --import tsx --test tests/google-proxy.test.ts",
    "build:server": "esbuild src/server/start-auth.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server/auth.cjs",
    "test:bundle": "node --import tsx tests/bundled-auth.e2e.ts",
    "test:k3d-auth": "node --import tsx tests/k3d-auth.e2e.ts",
    "test:model-gateway": "node --import tsx --test tests/model-gateway.test.ts",
    "test:run-store": "node --import tsx --test tests/run-store.test.ts",
    "test:pi-k3d": "node --import tsx tests/pi-k3d-gateway.e2e.ts",
    "test:desktop-k3d": "node --import tsx tests/desktop-k3d.e2e.ts",
    "test:desktop-resources": "node --import tsx --test tests/desktop-resources.test.ts",
    "test:runtime": "node --import tsx --test tests/model-gateway.test.ts tests/desktop-resources.test.ts tests/desktop-provisioner.test.ts tests/desktop-kubernetes.test.ts tests/pi-executor.test.ts tests/pi-runtime.test.ts",
    "test:runtime-mysql": "node --import tsx --test tests/run-store.test.ts tests/run-store-order.test.ts tests/run-scheduler.test.ts tests/run-http.test.ts tests/run-pipeline.test.ts",
    "test:run-browser": "node --import tsx tests/run-browser.e2e.ts",
    "test:provisioner-k3d": "node --import tsx tests/desktop-provisioner-k3d.e2e.ts",
    "test:kube-client-k3d": "node --import tsx tests/kube-client-k3d.e2e.ts",
    "build:deployment": "npm run build && node scripts/mark-web-build.mjs && npm run build:server"
  },
  "dependencies": {
    "google-auth-library": "11.1.0",
    "mysql2": "3.24.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
