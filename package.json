{
  "name": "coke-grok-bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/reference-frames.test.mjs",
    "test:mysql": "node --import tsx --test tests/mysql-tenant-store.test.ts",
    "test:ui": "node tests/ui.e2e.mjs",
    "compare:reference": "node --import tsx scripts/compare-reference.ts",
    "test:auth": "node --import tsx --test tests/google-auth.test.ts",
    "start:auth": "node --import tsx src/server/start-auth.ts"
  },
  "dependencies": {
    "google-auth-library": "11.1.0",
    "mysql2": "3.24.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright-core": "1.56.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
